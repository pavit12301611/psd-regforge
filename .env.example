# RegForge Firebase web-app configuration
# Copy this file to .env.local for local development.
# The browser config is public Firebase web-app configuration, not a service-account secret.

# Easiest option: paste the Firebase Console Web app config snippet here.
# FIREBASE_CONFIG={"apiKey":"...","authDomain":"...","projectId":"...","storageBucket":"...","messagingSenderId":"...","appId":"..."}
FIREBASE_CONFIG=

# Or provide the individual values below (NEXT_PUBLIC_ names are recommended).
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
NEXT_PUBLIC_FIREBASE_MEASUREMENT_ID=

# On Vercel, add the same values under Settings → Environment Variables for the
# environments you deploy, then redeploy because Firebase config is bundled at build time.
